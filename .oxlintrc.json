{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["react", "typescript", "nextjs", "import", "unicorn", "oxc"],
  "categories": {
    "correctness": "error",
    "suspicious": "warn"
  },
  "env": {
    "browser": true,
    "node": true,
    "es2024": true
  },
  "rules": {
    "react/react-in-jsx-scope": "off",
    "nextjs/no-img-element": "off",
    "import/no-unassigned-import": ["warn", { "allow": ["**/*.css"] }]
  },
  "overrides": [
    {
      "files": ["components/ui/**"],
      "rules": {
        "react/set-state-in-effect": "off",
        "eslint/no-shadow": "off",
        "eslint/no-underscore-dangle": "off"
      }
    }
  ],
  "ignorePatterns": ["drizzle/**", ".next/**", "scripts/scrape/__fixtures__/**", "next-env.d.ts"]
}
