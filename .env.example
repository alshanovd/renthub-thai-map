# Neon pooled connection string (app + scraper); comes from the Vercel Neon integration
DATABASE_URL=
# Neon direct (unpooled) connection string, used by drizzle-kit migrations
DATABASE_URL_UNPOOLED=
# Google Maps JavaScript API key (browser-exposed)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
# Google Maps map ID for Advanced Markers (DEMO_MAP_ID works for development)
NEXT_PUBLIC_GOOGLE_MAP_ID=
# Random 32-byte hex secret protecting /api/revalidate
REVALIDATE_SECRET=
# Local only: https://<prod-domain>/api/revalidate, called by the scraper after a run (skipped if empty)
REVALIDATE_URL=
